# Downloaded npm dependencies, once we install our first package.
node_modules/

# Files generated by the Compact compiler.
managed/

# Local checkpoint history and temporary grading probes.
.exercise-progress.json*
.exercise-probe-*.mjs

# Exercise build output and local secrets.
build/
.env.local
.private-state/
opening.json
deployment.json
round-deployment.json

# Temporary independent fixtures used by the checker regression tests.
.exercise-grader-*/

# Transient SDK type probes, removed after each checkpoint.
exercise-typecheck-*.ts

# Per-network secrets and participant records.
.env.*
!.env.example
.course-sessions/
release-evidence.local.json

# Local caches, editor-agent configuration and private work notes.
__pycache__/
*.pyc
.DS_Store
.codex/
.agents/
.claude/
private-notes/
*.private.md
